<?xml version="1.0" encoding="UTF-8"?>
<!-- Additional module: scaffolding for Vehicle, new subclass and interaction -->
<objectModel xmlns="http://standards.ieee.org/IEEE1516-2010">
  <objects>
    <objectClass>
      <name>HLAobjectRoot</name>
      <objectClass>
        <name>Vehicle</name>
        <objectClass>
          <name>Aircraft</name>
          <attribute>
            <name>Altitude</name>
            <transportation>HLAreliable</transportation>
            <order>TimeStamp</order>
          </attribute>
        </objectClass>
      </objectClass>
    </objectClass>
  </objects>
  <interactions>
    <interactionClass>
      <name>HLAinteractionRoot</name>
      <interactionClass>
        <name>Alarm</name>
        <transportation>HLAreliable</transportation>
        <order>Receive</order>
        <parameter><name>Code</name></parameter>
      </interactionClass>
    </interactionClass>
  </interactions>
</objectModel>
